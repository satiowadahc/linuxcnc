	$(ECHO) Linking $(notdir $@)
	$(CXX) $(LDFLAGS) -o $@  $(ULFLAGS)  $^ -lm -lcurses -lepoxy

USERSRCS += $(DISCRETEDROSRCS)
TARGETS += ../bin/discrete-dro

